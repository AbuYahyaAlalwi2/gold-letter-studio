# Environment template

DASHBOARD_TOKEN=change-me-secure-token
PORT=8080

# LiteLLM / model routing
LITELLM_API_KEY=sk-your-key
LITELLM_URL=http://litellm:4000
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_MODEL=ollama/llama3.1
FALLBACK_MODEL=openai/gpt-4o-mini

# Browser automation
PLAYWRIGHT_MCP_URL=http://playwright-mcp:8931

# Static analysis
SEMGREP_RULES_PATH=/workspace
SEMGREP_TIMEOUT_SECONDS=120

# Memory
MEM0_URL=http://mem0:8000
MEM0_API_KEY=mem0-dev-key

# Project integration
PROJECT_ROOT=/workspace
GITHUB_TOKEN=

# Sandbox
SANDBOX_TIMEOUT_SECONDS=180
