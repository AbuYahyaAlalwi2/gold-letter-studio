# Copy to .env and replace the dashboard token before starting.
DASHBOARD_TOKEN=replace-with-a-long-random-secret
PORT=8080

# LiteLLM gateway. Internal Docker network only.
LITELLM_MASTER_KEY=replace-with-another-long-random-secret
DEFAULT_MODEL=local-model
FALLBACK_MODEL=hosted-model
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Workspace paths inside containers
PROJECT_ROOT=/workspace
DATABASE_PATH=/data/agent.sqlite3
SEMGREP_TIMEOUT_SECONDS=120
