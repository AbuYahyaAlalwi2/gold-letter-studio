# Template only. Store actual values in an env file outside this repository
# and pass it with `docker compose --env-file <external-file>`.
LITELLM_MASTER_KEY=replace-with-long-random-secret
PLUGIN_SERVICE_TOKEN=replace-with-another-long-random-secret

# Primary OpenAI-compatible provider.
UPSTREAM_API_BASE=https://api.openai.com/v1
UPSTREAM_API_KEY=replace-with-your-provider-api-key
UPSTREAM_MODEL=openai/model-name

# Fallback provider; Ollama is shown as an example. The Ollama endpoint must
# be reachable from Docker, e.g. http://host.docker.internal:11434.
FALLBACK_API_BASE=http://host.docker.internal:11434
FALLBACK_API_KEY=ollama
FALLBACK_MODEL=ollama/qwen2.5-coder:7b

# Optional Mem0 Platform integration. SQLite remains the local persistent store.
MEM0_API_KEY=

# DSH uses its own short-lived launch token and signed session cookie.
DSH_PUBLIC_URL=http://localhost:3000/
DSH_TRUSTED_HOST=localhost
